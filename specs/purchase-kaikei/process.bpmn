<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:mermaid="http://mermaid.io/schema/extension" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_r9b6dd" targetNamespace="http://tecnos.co.jp/sdd/PURCHASEKAIKEI" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="Collaboration_BPMN-PROC-PURCHASEKAIKEI">
    <bpmn:documentation>Collaboration root for 購買会計プロセス</bpmn:documentation>
    <bpmn:participant id="Participant_BPMN-PROC-PURCHASEKAIKEI" name="購買会計プロセス" processRef="BPMN-PROC-PURCHASEKAIKEI">
      <bpmn:documentation>Participant lane for 購買会計プロセス</bpmn:documentation>
    </bpmn:participant>
  </bpmn:collaboration>
  <bpmn:process id="BPMN-PROC-PURCHASEKAIKEI" name="購買会計プロセス" isExecutable="true">
    <bpmn:documentation>購買会計プロセス (v2・1段承認・会計エンジン内蔵)
部長の 1 段承認。却下時は理由を記録し、同一申請書で再申請できる (履歴保持)。
検収は分割可。検収ごとに支払予定を計上し、内蔵会計エンジンで仕訳 (仕入高/買掛金) を自動計上。
支払実行時も仕訳 (買掛金/普通預金) を自動計上。外部 API 連携はない。</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:properties />
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_BPMN-PROC-PURCHASEKAIKEI">
      <bpmn:lane id="Lane_Admin" name="管理担当">
        <bpmn:flowNodeRef>BPMN-TASK-003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BPMN-TASK-005</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BPMN-TASK-006</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BPMN-TASK-007</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BPMN-TASK-008</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BPMN-EVT-002</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="部長">
        <bpmn:flowNodeRef>BPMN-TASK-004</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BPMN-TASK-002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BPMN-GW-001</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Applicant" name="申請者">
        <bpmn:flowNodeRef>BPMN-EVT-001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BPMN-TASK-001</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="BPMN-EVT-001" name="開始">
      <bpmn:outgoing>BPMN-FLOW-001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="BPMN-TASK-001" name="購買申請登録（部門付き）">
      <bpmn:documentation>task: 購買申請登録（部門付き）</bpmn:documentation>
      <bpmn:incoming>BPMN-FLOW-001</bpmn:incoming>
      <bpmn:incoming>BPMN-FLOW-006</bpmn:incoming>
      <bpmn:outgoing>BPMN-FLOW-002</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="BPMN-TASK-003" name="発注">
      <bpmn:documentation>task: 発注</bpmn:documentation>
      <bpmn:incoming>BPMN-FLOW-004</bpmn:incoming>
      <bpmn:outgoing>BPMN-FLOW-007</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="BPMN-TASK-005" name="検収（仕訳計上: 仕入高/買掛金）">
      <bpmn:documentation>task: 検収（仕訳計上: 仕入高/買掛金）</bpmn:documentation>
      <bpmn:incoming>BPMN-FLOW-007</bpmn:incoming>
      <bpmn:outgoing>BPMN-FLOW-008</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="BPMN-TASK-006" name="支払予定登録">
      <bpmn:documentation>task: 支払予定登録</bpmn:documentation>
      <bpmn:incoming>BPMN-FLOW-008</bpmn:incoming>
      <bpmn:outgoing>BPMN-FLOW-009</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="BPMN-TASK-007" name="支払実行（仕訳計上: 買掛金/普通預金）">
      <bpmn:documentation>task: 支払実行（仕訳計上: 買掛金/普通預金）</bpmn:documentation>
      <bpmn:incoming>BPMN-FLOW-009</bpmn:incoming>
      <bpmn:outgoing>BPMN-FLOW-010</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="BPMN-TASK-008" name="試算表・元帳照会">
      <bpmn:documentation>task: 試算表・元帳照会</bpmn:documentation>
      <bpmn:incoming>BPMN-FLOW-010</bpmn:incoming>
      <bpmn:outgoing>BPMN-FLOW-011</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="BPMN-EVT-002" name="支払完了">
      <bpmn:incoming>BPMN-FLOW-011</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="BPMN-TASK-004" name="却下・理由記録">
      <bpmn:documentation>task: 却下・理由記録</bpmn:documentation>
      <bpmn:incoming>BPMN-FLOW-005</bpmn:incoming>
      <bpmn:outgoing>BPMN-FLOW-006</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="BPMN-TASK-002" name="部長承認">
      <bpmn:documentation>task: 部長承認</bpmn:documentation>
      <bpmn:incoming>BPMN-FLOW-002</bpmn:incoming>
      <bpmn:outgoing>BPMN-FLOW-003</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="BPMN-GW-001" name="承認結果?">
      <bpmn:documentation>Decision: 承認結果?</bpmn:documentation>
      <bpmn:incoming>BPMN-FLOW-003</bpmn:incoming>
      <bpmn:outgoing>BPMN-FLOW-004</bpmn:outgoing>
      <bpmn:outgoing>BPMN-FLOW-005</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="BPMN-FLOW-001" sourceRef="BPMN-EVT-001" targetRef="BPMN-TASK-001" />
    <bpmn:sequenceFlow id="BPMN-FLOW-006" name="再申請" sourceRef="BPMN-TASK-004" targetRef="BPMN-TASK-001" />
    <bpmn:sequenceFlow id="BPMN-FLOW-002" sourceRef="BPMN-TASK-001" targetRef="BPMN-TASK-002" />
    <bpmn:sequenceFlow id="BPMN-FLOW-004" name="承認" sourceRef="BPMN-GW-001" targetRef="BPMN-TASK-003">
      <bpmn:documentation>条件: 承認 の場合に進行</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=cond_BPMN_FLOW_004</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BPMN-FLOW-007" sourceRef="BPMN-TASK-003" targetRef="BPMN-TASK-005" />
    <bpmn:sequenceFlow id="BPMN-FLOW-008" sourceRef="BPMN-TASK-005" targetRef="BPMN-TASK-006" />
    <bpmn:sequenceFlow id="BPMN-FLOW-009" sourceRef="BPMN-TASK-006" targetRef="BPMN-TASK-007" />
    <bpmn:sequenceFlow id="BPMN-FLOW-010" sourceRef="BPMN-TASK-007" targetRef="BPMN-TASK-008" />
    <bpmn:sequenceFlow id="BPMN-FLOW-011" sourceRef="BPMN-TASK-008" targetRef="BPMN-EVT-002" />
    <bpmn:sequenceFlow id="BPMN-FLOW-005" name="却下" sourceRef="BPMN-GW-001" targetRef="BPMN-TASK-004">
      <bpmn:documentation>条件: 却下 の場合に進行</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=cond_BPMN_FLOW_005</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BPMN-FLOW-003" sourceRef="BPMN-TASK-002" targetRef="BPMN-GW-001" />
  </bpmn:process>
